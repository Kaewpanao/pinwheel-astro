---
import { markdownify } from "@/lib/utils/textConverter";
import Base from "@/layouts/Base.astro";

import { Swiper, SwiperWrapper, SwiperSlide, SwiperPagination } from "astro-swiper";
import type { SwiperOptions } from 'swiper/types'

const swiperOptions: SwiperOptions = {
  spaceBetween: 24,
  loop: true,
  pagination: {
    el: ".pagination",
    type: "bullets",
    clickable: true,
  },
  breakpoints: {
    768: {
      slidesPerView: 1,
    },
  },
}

---

<Base>
  <section>
    <div class="px-4 max-w-full">
      <div class="row">
        <div class="min-h-[980px] bg-white py-10 lg:col-6 lg:py-[114px]">
          <div class="mx-auto w-full max-w-[480px]">
            <img class="mb-8" src="/images/flower.png" alt="" />
            <h1 class="mb-4">เข้าสู่ระบบ</h1>
            <p>เข้าสู่ระบบเพื่อเริ่มต้นใช้งาน</p>
            <div class="signin-options mt-10">
              <a
                class="btn btn-outline-white block w-full text-text-dark"
                href="#">เข้าสู่ระบบด้วย Google</a
              >
            </div>
            <div
              class="relative my-8 text-center after:absolute after:left-0 after:top-1/2 after:z-[0] after:w-full after:border-b after:border-border after:content-['']"
            >
              <span class="relative z-[1] inline-block bg-white px-2"
                >หรือเข้าสู่ระบบด้วยอีเมล</span
              >
            </div>

            <form action="#">
              <div class="form-group">
                <label for="email" class="form-label">อีเมล</label>
                <input
                  type="email"
                  id="email"
                  class="form-control"
                  placeholder="อีเมลของคุณ"
                />
              </div>
              <div class="form-group mt-4">
                <label for="password" class="form-label">รหัสผ่าน</label>
                <input
                  type="password"
                  id="password"
                  class="form-control"
                  placeholder="รหัสผ่านของคุณ"
                />
              </div>
              <input
                class="btn btn-primary mt-10 block w-full"
                type="submit"
                value="เข้าสู่ระบบ"
              />
              <p class="mt-6 text-center">
                มีปัญหาในการเข้าสู่ระบบ?
                <a class="text-text-dark" href="/password-reset"
                  >รีเซ็ตรหัสผ่านของคุณ</a
                >
                <br />หรือ <a class="text-text-dark" href="/signup">ลงทะเบียน</a> เพื่อ
                สร้างบัญชีใหม่
              </p>
            </form>
          </div>
        </div>

        <!-- Swiper Section -->
        <div
          class="auth-banner bg-gradient flex flex-col items-center justify-center py-16 lg:col-6 lg:block overflow-hidden"
        >
          <img
            class="absolute left-0 top-0 h-full w-full"
            src="/images/login-banner-bg.png"
            alt="bg-image"
          />
          <div class="w-full text-center">
            <h2
              class="h3 text-white"
              set:html={markdownify(
                "นำไอเดียทั้งหมดของคุณ<br />มาเป็นจริง"
              )}
            />
            <div class="auth-banner-carousel">
              <Swiper options={swiperOptions} class="swiper-container">
                <SwiperWrapper>
                  <!-- Static Image Slides for Demo -->
                  <SwiperSlide>
                    <img
                      width="667"
                      height="557"
                      class="mx-auto"
                      src="/images/signup-carousel-img-1.png"
                      alt=""
                    />
                  </SwiperSlide>
                  <SwiperSlide>
                    <img
                      width="667"
                      height="557"
                      class="mx-auto"
                      src="/images/signup-carousel-img-1.png"
                      alt=""
                    />
                  </SwiperSlide>
                  <SwiperSlide>
                    <img
                      width="667"
                      height="557"
                      class="mx-auto"
                      src="/images/signup-carousel-img-1.png"
                      alt=""
                    />
                  </SwiperSlide>
                </SwiperWrapper>

                <SwiperPagination class="relative flex justify-center pagination" />
              </Swiper>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
