---
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";

import { Swiper, SwiperWrapper, SwiperSlide, SwiperPagination } from "astro-swiper";
import type { SwiperOptions } from 'swiper/types'

const swiperOptions: SwiperOptions = {
  spaceBetween: 24,
  loop: true,
  pagination: {
    el: ".pagination",
    type: "bullets",
    clickable: true,
  },
  breakpoints: {
    768: {
      slidesPerView: 1,
    },
  },
}

---

<Base>
  <section>
    <div class="px-4 max-w-full">
      <div class="row">
        <div class="min-h-[980px] bg-white py-10 lg:col-6 lg:py-[114px]">
          <div class="mx-auto w-full max-w-[480px]">
            <img class="mb-8" src="/images/flower.png" alt="" />
            <h1 class="mb-4">รีเซ็ตรหัสผ่าน</h1>
            <p>
              ป้อนอีเมลของบัญชีคุณเพื่อขอรีเซ็ตรหัสผ่าน
              อีเมลจะถูกส่งไปยังอีเมลของบัญชีคุณ
              พร้อมลิงก์สำหรับรีเซ็ต
            </p>
            <form action="#">
              <div class="form-group">
                <label for="email" class="form-label">อีเมล</label>
                <input
                  type="email"
                  id="email"
                  class="form-control"
                  placeholder="อีเมลของคุณ"
                />
              </div>
              <input
                class="btn btn-primary mt-10 block w-full"
                type="submit"
                value="รีเซ็ตรหัสผ่าน"
              />
              <p class="mt-6 text-center">
                ยังไม่มีบัญชี?
                <a class="text-text-dark" href="/signup">ลงทะเบียน</a> เพื่อสร้างบัญชี
                <br />หรือ <a class="text-text-dark" href="/signin">เข้าสู่ระบบ</a> เพื่อ
                เข้าสู่บัญชีของคุณ
              </p>
            </form>
          </div>
        </div>

        <!-- Swiper Section -->
        <div
          class="auth-banner bg-gradient flex flex-col items-center justify-center py-16 lg:col-6 lg:block overflow-hidden"
        >
          <img
            class="absolute left-0 top-0 h-full w-full"
            src="/images/login-banner-bg.png"
            alt="bg-image"
          />
          <div class="w-full text-center">
            <h2
              class="h3 text-white"
              set:html={markdownify("ทำให้ความฝันทั้งหมด<br/>ของคุณเป็นจริง")}
            />
            <div class="auth-banner-carousel">
              <Swiper options={swiperOptions} class="swiper-container">
                <SwiperWrapper>
                  <!-- Static Image Slides for Demo -->
                  <SwiperSlide>
                    <img
                      width="667"
                      height="557"
                      class="mx-auto"
                      src="/images/signup-carousel-img-1.png"
                      alt=""
                    />
                  </SwiperSlide>
                  <SwiperSlide>
                    <img
                      width="667"
                      height="557"
                      class="mx-auto"
                      src="/images/signup-carousel-img-1.png"
                      alt=""
                    />
                  </SwiperSlide>
                  <SwiperSlide>
                    <img
                      width="667"
                      height="557"
                      class="mx-auto"
                      src="/images/signup-carousel-img-1.png"
                      alt=""
                    />
                  </SwiperSlide>
                </SwiperWrapper>

                <SwiperPagination class="relative flex justify-center pagination" />
              </Swiper>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
